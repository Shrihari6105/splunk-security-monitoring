| makeresults count=60 | streamstats count AS n | eval i=n-1, t=strptime("2025-06-12 08:52:00","%Y-%m-%d %H:%M:%S")+i, src_ip="203.0.113.77", dest_ip="10.0.0.5", bytes=60, port=if(i<27, tonumber(mvindex(split("21,22,23,25,53,80,110,111,135,139,143,443,445,993,995,1433,1521,3306,3389,5432,5900,5985,6379,8080,8443,9200,27017",","), i)), 1024+7*(i-27)), action=if(port==80 OR port==443,"allowed","blocked"), protocol="TCP", country="RU", scenario="F1_port_scan"
| append [| makeresults count=40 | streamstats count AS n | eval i=n-1, t=strptime("2025-06-12 08:55:00","%Y-%m-%d %H:%M:%S")+6*i, src_ip="198.51.100.61", dest_ip="10.0.0.7", bytes=300+(i*67)%600, action=if(i%4==0,"allowed","blocked"), port=3389, protocol="TCP", country="CN", scenario="F2_rdp_bruteforce"]
